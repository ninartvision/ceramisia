{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "destination": "/api/apple-pay-domain"
    },
    {
      "source": "/terms",
      "destination": "/terms/"
    },
    {
      "source": "/privacy",
      "destination": "/page/?slug=privacy"
    },
    {
      "source": "/privacy/",
      "destination": "/page/?slug=privacy"
    }
  ]
}
