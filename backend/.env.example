# Ceramisia Payment Backend – Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# ── BOG Credentials (from BOG Business Portal) ────────────────────────────────
BOG_CLIENT_ID=your_client_id_here
BOG_SECRET_KEY=your_secret_key_here

# ── Redirect / Callback URLs ──────────────────────────────────────────────────
SUCCESS_URL=https://ceramisia.com/payment-success
FAIL_URL=https://ceramisia.com/payment-fail
CALLBACK_URL=https://ceramisia.com/payment-callback

# ── CORS (your frontend origin) ───────────────────────────────────────────────
ALLOWED_ORIGIN=https://ceramisia.com

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
