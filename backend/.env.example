# Ceramisia Payment Backend – Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# ── BOG Credentials (from BOG Business Portal) ────────────────────────────────
BOG_CLIENT_ID=your_client_id_here
BOG_CLIENT_SECRET=your_client_secret_here

# ── Redirect URLs after payment ───────────────────────────────────────────────
BOG_SUCCESS_URL=https://ceramisia.com/payment-success
BOG_FAIL_URL=https://ceramisia.com/payment-fail
BOG_CALLBACK_URL=https://ceramisia.com/payment-callback

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
