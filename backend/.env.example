# Ceramisia Payment – Environment Variables
# Set all of these in Vercel → Project → Settings → Environment Variables.
# Never commit .env to git.

# ── BOG Credentials — copy from bonline / developer portal (never commit real secrets to git) ─
BOG_CLIENT_ID=10007451
# Used by root serverless /api/pay (also accepts BOG_SECRET_KEY)
BOG_CLIENT_SECRET=PASTE_SECRET_HERE
# Used by backend/server.js locally
BOG_SECRET_KEY=PASTE_SECRET_HERE

# Installment checkout (/api/bog-installment) — same pair if BOG assigned one integration
BOG_INSTALL_CLIENT_ID=10007451
BOG_INSTALL_SECRET_KEY=PASTE_SECRET_HERE

# ── BOG RSA Public Key (from BOG developer portal → Integration → Public Key) ─
# Paste the full PEM block. On Vercel, replace real newlines with \n in the value.
BOG_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# ── Redirect / Callback URLs ──────────────────────────────────────────────────
CALLBACK_URL=https://ceramisia.com/api/callback
SUCCESS_URL=https://ceramisia.com/success.html
FAIL_URL=https://ceramisia.com/fail.html

# Flitt/TBC — browser return POST (not static success.html); lands on success.html via redirect
FLITT_RESPONSE_URL=https://ceramisia.com/api/flitt-return
FLITT_SERVER_CALLBACK_URL=https://ceramisia.com/api/flitt-callback

# ── Flitt/TBC sandbox (merchant 4056481 — production-readiness testing) ─────────
# Use on Preview or dedicated test env — do not mix sandbox secret with live host.
# FLITT_SANDBOX=1
# FLITT_ENV=sandbox
# FLITT_MERCHANT_ID=4056481
# FLITT_PRIVATE_KEY=PASTE_SANDBOX_SECRET_FROM_FLITT_PORTAL
# Optional: FLITT_CHECKOUT_MODE=url (default) | token (wallet SDK — flitt-wallet-test.html)
# Sandbox cards: https://docs.flitt.com/api/testing (e.g. 4444555566661111)
# FLITT_APPLE_PAY_DOMAIN_ASSOCIATION=PASTE_FILE_BODY_FROM_FLITT_SUPPORT
# Served at /.well-known/apple-developer-merchantid-domain-association

# ── Flitt/TBC production (merchant 4056481) ───────────────────────────────────
# FLITT_MERCHANT_ID=4056481
# FLITT_PRIVATE_KEY=PASTE_LIVE_SECRET_FROM_FLITT_PORTAL
# Unset FLITT_SANDBOX / FLITT_ENV for pay.flitt.com live checkout

# ── CORS (your frontend origin) ───────────────────────────────────────────────
ALLOWED_ORIGIN=https://ceramisia.com

# ── Supabase (Project Settings → API) ────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Sanity (Orders & Inquiries in Studio) ─────────────────────────────────────
# https://sanity.io/manage → project uemjhi9v → API → Tokens (Editor: create + update)
SANITY_API_TOKEN=your_sanity_write_token_here
# Optional overrides (defaults match sanity-studio/sanity.config.js)
# SANITY_PROJECT_ID=uemjhi9v
# SANITY_DATASET=production
# SANITY_SKIP_ORDER_SYNC=1

# ── Admin API (protect /check-payment and /refund) ────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your_random_secret_here
